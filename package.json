{
  "name": "secondlook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently --kill-others \"node --env-file-if-exists=.env --import tsx src/server/main.ts\" \"vite\"",
    "dev:fixture": "YOUCAM_MODE=fixture pnpm dev",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:one": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:pure": "vitest run --config vitest.pure.config.ts",
    "test:img": "vitest run --config vitest.img.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "e2e": "playwright test",
    "screenshots": "node scripts/not-implemented.mjs S4",
    "fixtures:generate": "tsx scripts/gen-fixtures.ts",
    "check:env": "node --env-file-if-exists=.env --import tsx scripts/check-env.ts",
    "youcam:preflight": "node scripts/not-implemented.mjs S2",
    "youcam:probe": "node scripts/not-implemented.mjs S4",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "@hono/node-server": "1.19.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "vitest": "4.1.12",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "concurrently": "9.2.5",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "jsdom": "27.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
